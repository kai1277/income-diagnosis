// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model OccupationType {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  label      String
  is_active  Boolean  @default(true)
  sort_order Int?
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)

  job_occupation_types JobOccupationType[]

  @@map("occupation_types")
}

model Prefecture {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  sort_order Int
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)

  cities City[]
  jobs   Job[]

  @@map("prefectures")
}

model City {
  id            String   @id @default(uuid()) @db.Uuid
  prefecture_id String   @db.Uuid
  name          String
  sort_order    Int
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamp(6)

  prefecture Prefecture @relation(fields: [prefecture_id], references: [id])
  jobs       Job[]

  @@map("cities")
}

model Job {
  id                   String    @id @default(uuid()) @db.Uuid
  title                String
  image_url            String?
  badge_text           String?
  salary_type          String
  salary_min           Int?
  salary_max           Int?
  salary_range_type    String
  salary_text          String
  job_location         String?
  prefecture_id        String?   @db.Uuid
  city_id              String?   @db.Uuid
  job_types            Json      @default("[]")
  affiliate_url        String
  impression_pixel_url String
  affiliate_network    String
  is_active            Boolean   @default(true)
  created_at           DateTime  @default(now()) @db.Timestamp(6)
  updated_at           DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  expires_at           DateTime? @db.Timestamp(6)

  prefecture           Prefecture?         @relation(fields: [prefecture_id], references: [id])
  city                 City?               @relation(fields: [city_id], references: [id])
  job_requirements     JobRequirement[]
  job_occupation_types JobOccupationType[]

  @@map("jobs")
}

model JobOccupationType {
  job_id             String   @db.Uuid
  occupation_type_id String   @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamp(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamp(6)

  job             Job            @relation(fields: [job_id], references: [id], onDelete: Cascade)
  occupation_type OccupationType @relation(fields: [occupation_type_id], references: [id])

  @@id([job_id, occupation_type_id])
  @@map("job_occupation_types")
}

model JobRequirement {
  id                  String   @id @default(uuid()) @db.Uuid
  job_id              String   @db.Uuid
  requirement_code_id String   @db.Uuid
  level               String
  operator            String
  value               String?
  created_at          DateTime @default(now()) @db.Timestamp(6)
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamp(6)

  job              Job             @relation(fields: [job_id], references: [id], onDelete: Cascade)
  requirement_code RequirementCode @relation(fields: [requirement_code_id], references: [id])

  @@map("job_requirements")
}

model RequirementCode {
  id                String   @id @default(uuid()) @db.Uuid
  category          String
  code              String
  label             String
  value_type        String
  allowed_operators Json
  is_active         Boolean  @default(true)
  sort_order        Int?
  created_at        DateTime @default(now()) @db.Timestamp(6)
  updated_at        DateTime @default(now()) @updatedAt @db.Timestamp(6)

  job_requirements JobRequirement[]

  @@unique([category, code])
  @@map("requirement_codes")
}
